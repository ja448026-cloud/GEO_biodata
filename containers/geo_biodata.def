Bootstrap: docker
From: rocker/r-ver:4.5.0

%post
    R -q -e "install.packages(c('BiocManager','httr2','jsonlite','digest','yaml'), repos='https://cloud.r-project.org')"
    R -q -e "BiocManager::install(c('GEOquery','Biobase'), ask=FALSE, update=FALSE)"

%runscript
    cd /workflow
    Rscript skills/geo-biodata-workflow/scripts/bootstrap_environment.R --profile core --check
